@model BookManagerApp.Models.Book

@{
    ViewData["Title"] = "Xóa sách";
}

<h2 class="text-danger">Xóa Sách</h2>
<h3>Bạn có chắc chắn muốn xóa cuốn sách này không?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Author)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Author)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Genre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Genre)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>